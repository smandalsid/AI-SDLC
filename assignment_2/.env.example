# Copy to .env and edit. Never commit .env. Placeholders only.
# When both tokens are empty the logged-in `gh` user is used.
MODEL_ID=mai-code-1.1-flash
REASONING_EFFORT=low
SDK_TIMEOUT_SECONDS=60
REQUEST_BODY_MAX_BYTES=1048576
# Empty means CORS is disabled; otherwise a comma-separated list of allowed origins.
CORS_ORIGINS=
LOG_LEVEL=INFO
GH_TOKEN=
COPILOT_GITHUB_TOKEN=
