{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "output-schema.json",
  "title": "ProposedAction: the one structured action returned for every request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intent",
    "title",
    "datetime_iso",
    "snooze_minutes",
    "target_reminder_id",
    "clarification_question",
    "refusal_reason",
    "confidence"
  ],
  "properties": {
    "intent": {"enum": ["create", "reschedule", "snooze", "cancel", "clarify", "refuse"]},
    "title": {"type": ["string", "null"], "minLength": 1, "maxLength": 120},
    "datetime_iso": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]+)?)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "snooze_minutes": {"type": ["integer", "null"], "minimum": 1, "maximum": 1440},
    "target_reminder_id": {"type": ["string", "null"]},
    "clarification_question": {"type": ["string", "null"], "minLength": 1, "maxLength": 200},
    "refusal_reason": {"enum": ["unsafe", "injection", "out_of_scope", "bulk_action", "too_long", null]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"intent": {"const": "create"}}, "required": ["intent"]},
      "then": {"properties": {"title": {"type": "string"}, "datetime_iso": {"type": "string"}}}
    },
    {
      "if": {"properties": {"intent": {"const": "reschedule"}}, "required": ["intent"]},
      "then": {"properties": {"target_reminder_id": {"type": "string"}, "datetime_iso": {"type": "string"}}}
    },
    {
      "if": {"properties": {"intent": {"const": "snooze"}}, "required": ["intent"]},
      "then": {"properties": {"target_reminder_id": {"type": "string"}, "snooze_minutes": {"type": "integer"}}}
    },
    {
      "if": {"properties": {"intent": {"const": "cancel"}}, "required": ["intent"]},
      "then": {"properties": {"target_reminder_id": {"type": "string"}}}
    },
    {
      "if": {"properties": {"intent": {"const": "clarify"}}, "required": ["intent"]},
      "then": {"properties": {"clarification_question": {"type": "string"}}},
      "else": {"properties": {"clarification_question": {"type": "null"}}}
    },
    {
      "if": {"properties": {"intent": {"const": "refuse"}}, "required": ["intent"]},
      "then": {"properties": {"refusal_reason": {"type": "string"}}},
      "else": {"properties": {"refusal_reason": {"type": "null"}}}
    }
  ]
}
